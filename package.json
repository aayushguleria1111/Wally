{
  "name": "wally-live-wallpapers",
  "version": "1.0.1",
  "description": "Wally-Live Wallpapers - Modern Windows Live Wallpaper Application",
  "main": "electron/main.js",
  "author": "Aayush Guleria",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aayushguleria1111/Wally.git"
  },
  "scripts": {
    "start": "electron . --disable-gpu --no-sandbox",
    "dev": "electron . --enable-logging --disable-gpu --no-sandbox",
    "test": "node test/test-suite.js",
    "build:native": "node scripts/build-native.js",
    "generate:icons": "node scripts/generate-icons.js",
    "pack": "npm run build:native && electron-builder --dir",
    "dist": "node scripts/build-installer.js"
  },
  "build": {
    "appId": "com.wally.livewallpapers",
    "productName": "Wally-Live Wallpapers",
    "copyright": "Copyright © 2026 Wally-Live Wallpapers",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wally-Live Wallpapers",
      "differentialPackage": false,
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "bin/native",
        "to": "native",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
