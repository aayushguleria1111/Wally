{
  "name": "wally",
  "version": "1.0.0",
  "description": "Modern Windows Live Wallpaper Application",
  "main": "electron/main.js",
  "author": "Aayush Guleria",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aayushguleria1111/Wally.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build:native": "node scripts/build-native.js",
    "generate:icons": "node scripts/generate-icons.js",
    "pack": "npm run build:native && electron-builder --dir",
    "dist": "npm run build:native && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.wally.livewallpaper",
    "productName": "Wally",
    "copyright": "Copyright © 2026 Wally",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wally Live Wallpaper"
    },
    "extraResources": [
      {
        "from": "bin/native",
        "to": "native",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
